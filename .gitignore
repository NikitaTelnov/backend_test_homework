# Игнорируем папку виртуального окружения (где лежат библиотеки)
venv/
.env

# Игнорируем кэш Python (файлы .pyc и папку __pycache__)
__pycache__/
*.pyc

# Игнорируем кэш тестов pytest (он появляется при запуске тестов)
.pytest_cache/

# Игнорируем настройки IDE (чтобы не путать репозитории разных людей)
.idea/
.vscode/

# Игнорируем файлы операционной системы (для Mac/Linux, но безвредно и в Windows)
.DS_Store
Thumbs.db